{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InventoryApi": {
    "PageSize": 25,
    "MaxAttempts": 5,
    "AttemptTimeout": "00:00:10",
    "BaseBackoff": "00:00:00.500",
    "MaxRetryDelay": "00:00:30",
    "CacheTtl": "00:05:00"
  }
}
